{
  "name": "devlingo",
  "displayName": "DevLingo",
  "description": "Translate Markdown files and code comments directly in VS Code.",
  "version": "0.1.0-alpha.2",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:php",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:less",
    "onLanguage:python",
    "onLanguage:shellscript",
    "onLanguage:html"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devlingo.translateSelection",
        "title": "DevLingo: Translate Selection"
      }
    ],
    "configuration": {
      "title": "DevLingo",
      "properties": {
        "devlingo.targetLanguage": {
          "type": "string",
          "enum": [
            "en",
            "fr",
            "es",
            "de"
          ],
          "enumDescriptions": [
            "English",
            "French",
            "Spanish",
            "German"
          ],
          "default": "fr",
          "description": "Default target language for comment translations on hover."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
